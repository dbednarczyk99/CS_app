# Adres API (serwera) – lokalnie http://localhost:3000, na produkcji https://api.chlebasmak.pl
VITE_API_URL=http://localhost:3000
# Klucz Map Google (pole „Uzupełnij z adresu” w piekarniach i chlebowozie)
VITE_GOOGLE_MAPS_API_KEY=
# Adres strony (podglądy w panelu) – lokalnie http://localhost:3001, na produkcji https://chlebasmak.pl
VITE_WEB_URL=http://localhost:3001

# Pomoc techniczna – kontakt do wykonawcy strony, widoczny w panelu: Pomoc → „Pomoc techniczna”.
# Puste – panel pokazuje „Dane kontaktowe zostaną uzupełnione przy uruchomieniu strony”. Uzupełnić przy wdrożeniu.
VITE_SUPPORT_NAME=
VITE_SUPPORT_PHONE=
VITE_SUPPORT_EMAIL=
