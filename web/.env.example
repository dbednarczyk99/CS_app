# Adres API (NestJS) – pobieranie danych po stronie serwera
API_URL=http://localhost:3000

# Google Maps – klucz przeglądarkowy (ograniczony do domen) i Map ID ze stylem z docs/mapa-styl.json
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Sekret do /api/revalidate – API woła go po zmianach w panelu (ten sam co REVALIDATE_SECRET w API)
REVALIDATE_SECRET=

# Adres strony (bez ukośnika na końcu) – adresy kanoniczne, mapa strony, podgląd linków przy udostępnianiu, dane dla Google.
# Na produkcji: docelowa domena, np. https://chlebasmak.pl
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# adres panelu administracyjnego – tylko on może przesłać wpis do podglądu (/podglad/wpis)
NEXT_PUBLIC_ADMIN_URL=http://localhost:5173
