// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


// USER & AUTH 
enum Role {
  ADMIN
  EDITOR
  BLOGGER
  VIEWER
}

model User {
  id          String  @id @default(uuid())
  role        Role
  login       String  @unique
  password    String
}


// PRODUCTS
model Category {
  id          String  @id @default(uuid())
  name        String
  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  isSeasonal  Boolean   @default(false)
  isActive    Boolean   @default(true)
  images      ProductImages[]
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductImages {
  id          String @id @default(uuid())
  imgUrl      String
  product     Product @relation(fields: [productId], references: [id])
  productId   String
}


// CONTACT INFO

model Location {
  id              String    @id @default(uuid())
  name            String?
  address         String
  googleMapsUrl   String
  openingHours    Json?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model BreadVanLocation {
  id              String @id @default(uuid())
  address         String
  googleMapsUrl   String
  dayOfTheWeek    String  
  startTime       String
  endTime         String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ContactType  {
  PHONE
  EMAIL
  OTHER
}

model ContactInfo {
  id          String @id @default(uuid())
  type        ContactType
  label       String?
  value       String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Media {
  id          String @id @default(uuid())
  url         String
  name        String
  icon        String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


// BLOG

model ArticleImages {
  id          String @id @default(uuid())
  imgUrl         String
  article     BlogItem @relation(fields: [articleId], references: [id])
  articleId   String

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BlogItem {
  id                String  @id @default(uuid())
  title             String
  shortDescription  String
  content           String
  images            ArticleImages[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
