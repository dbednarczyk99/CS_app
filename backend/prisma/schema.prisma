// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// USER & AUTH 
enum Role {
  ADMIN
  EDITOR
  BLOGGER
  VIEWER
}

model User {
  id           String   @id @default(uuid())
  role         Role
  login        String   @unique
  // nazwa wyświetlana w panelu, np. „Właściciel”
  name         String?  @db.VarChar(60)
  password     String
  // zwiększana przy zmianie hasła – wcześniejsze tokeny (sesje) przestają działać
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
}

// PRODUCTS
model Category {
  id       String    @id @default(uuid())
  name     String
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id               String            @id @default(uuid())
  name             String
  // adres na stronie: /oferta/<slug> (z nazwy, ustalany przy dodaniu – zmiana nazwy nie psuje linków)
  slug             String?           @unique @db.VarChar(80)
  description      String            @db.Text
  price            Float
  isSeasonal       Boolean           @default(false)
  // tylko dla sezonowych: false = poza sezonem (widoczny na stronie, ale niedostępny i bez rezerwacji)
  inSeason         Boolean           @default(true)
  // etykiety na karcie produktu (np. Nowość, Bestseller) – lista etykiet zarządzana w panelu
  labels           ProductLabel[]
  // promocja: etykieta „Promocja” i opcjonalnie niższa cena w okresie od–do
  // (dni w czasie polskim YYYY-MM-DD; puste = bez ograniczenia z tej strony)
  isPromo          Boolean           @default(false)
  promoPrice       Float?
  promoFrom        String?           @db.Char(10)
  promoTo          String?           @db.Char(10)
  isActive         Boolean           @default(true)
  // czy produkt można zarezerwować online (np. lody i napoje – tylko do wglądu)
  isReservable     Boolean           @default(true)
  // planowanie (dzień YYYY-MM-DD, czas polski): od tego dnia produkt sam się włącza (aktywny, a sezonowy –
  // w sezonie) / wyłącza (sezonowy – poza sezonem, zwykły – ukryty); data czyści się po wykonaniu
  availableFrom    String?           @db.Char(10)
  unavailableFrom  String?           @db.Char(10)
  images           ProductImages[]
  reservationItems ReservationItem[]
  category         Category          @relation(fields: [categoryId], references: [id])
  categoryId       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// etykieta produktu dodawana w panelu (Nowość, Bestseller, Wegańskie…)
model ProductLabel {
  id         String    @id @default(uuid())
  name       String    @unique @db.VarChar(30)
  // w adresie filtra oferty: /oferta?etykiety=nowosci
  slug       String    @unique @db.VarChar(40)
  // wygląd na stronie: gold | cream | dark | green | red
  color      String    @default("gold") @db.VarChar(10)
  // etykieta stała, nadawana przez stronę ("promo" – trwająca promocja): można zmienić nazwę, kolor
  // i kolejność, ale nie usunąć ani przypisać ręcznie do produktu
  system     String?   @unique @db.VarChar(20)
  // okres widoczności na stronie (YYYY-MM-DD, czas polski, włącznie); puste = bez ograniczenia
  activeFrom String?   @db.Char(10)
  activeTo   String?   @db.Char(10)
  // kolejność na karcie produktu i w filtrach (mniejsza = wcześniej)
  order      Int       @default(0)
  products   Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// historia promocji – do zestawienia „Skuteczność promocji” (rezerwacje w czasie promocji i przed nią)
model PromoPeriod {
  id          String    @id @default(uuid())
  productId   String
  productName String
  price       Float
  promoPrice  Float?
  // okres (YYYY-MM-DD); from – początek (data z panelu albo dzień włączenia), to – koniec (null = bez końca)
  from        String    @db.Char(10)
  to          String?   @db.Char(10)
  // promocję wyłączono w panelu (null = trwa / zaplanowana)
  endedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, endedAt])
}

model ProductImages {
  id        String   @id @default(uuid())
  imgUrl    String
  order     Int
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, order])
}

// CONTACT INFO

model Location {
  id                String          @id @default(uuid())
  name              String?
  address           String
  phone             String?
  // skrót do numerów rezerwacji, np. WIL → WIL-1017-03
  code              String?         @unique @db.VarChar(6)
  googleMapsUrl     String
  // współrzędne do mapy na stronie
  lat               Float?
  lng               Float?
  openingHours      Json?
  reservations      Reservation[]
  // zdjęcia lokalu (karuzela na stronie /piekarnie)
  images            LocationImage[]
  // Google: identyfikator miejsca (ocena i link „Wystaw opinię”) + ocena odświeżana raz dziennie
  googlePlaceId     String?         @db.VarChar(300)
  googleRating      Float?
  googleRatingCount Int?
  googleRatingAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LocationImage {
  id         String   @id @default(uuid())
  imgUrl     String
  order      Int
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ContactType {
  PHONE
  EMAIL
  OTHER
}

model ContactInfo {
  id    String      @id @default(uuid())
  type  ContactType
  label String?
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// BREAD-VAN

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model BreadVanLocation {
  id            String        @id @default(uuid())
  address       String
  googleMapsUrl String
  lat           Float?
  lng           Float?
  dayOfTheWeek  Weekday       @unique
  reservations  Reservation[]
  startTime     String
  endTime       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BreadVanDescription {
  id               String           @id @default("singleton")
  shortDescription String
  longDescription  String           @db.VarChar(500)
  images           BreadVanImages[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BreadVanImages {
  id                  String              @id @default(uuid())
  imgUrl              String
  order               Int
  breadVanDescription BreadVanDescription @relation(fields: [descriptionId], references: [id])
  descriptionId       String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([descriptionId, order])
}

// SOCIAL MEDIA

enum MediaName {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  LINKEDIN
  TWITTER
  PINTEREST
  YOUTUBE
}

model Media {
  id   String    @id @default(uuid())
  url  String
  name MediaName @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// BLOG

// BLOG

model ArticleImages {
  id        String   @id @default(uuid())
  imgUrl    String
  order     Int
  article   Article  @relation(fields: [articleId], references: [id])
  articleId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, order])
}

model Article {
  id                   String          @id @default(uuid())
  title                String
  // adres na stronie: /aktualnosci/<slug> (z tytułu, ustalany przy dodaniu)
  slug                 String?         @unique @db.VarChar(100)
  shortDescription     String          @db.VarChar(500)
  content              String          @db.Text
  images               ArticleImages[]
  tags                 TagOnArticle[]
  // false = wpis tylko dla subskrybentów newslettera (niewidoczny na stronie)
  isPublished          Boolean         @default(true)
  // wysyłka do zapisanych w newsletterze – raz, przy zapisaniu artykułu z zaznaczoną flagą
  sendAsNewsletter     Boolean         @default(true)
  newsletterSentAt     DateTime?
  newsletterRecipients Int?
  // zaplanowana publikacja na stronie i wysyłka newslettera (czas); null = od razu przy zapisie
  publishAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArticleTag {
  id       String         @id @default(uuid())
  name     String         @unique
  articles TagOnArticle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TagOnArticle {
  article   Article @relation(fields: [articleId], references: [id])
  articleId String

  tag   ArticleTag @relation(fields: [tagId], references: [id])
  tagId String

  @@id([articleId, tagId])
}

// RESERVATIONS – rezerwacje pieczywa z odbiorem i płatnością na miejscu

enum PickupType {
  STORE
  VAN
}

enum ReservationStatus {
  NEW // przyjęta
  CANCELLED // anulowana przez klienta (link z e-maila)
}

model Reservation {
  id     String            @id @default(uuid())
  // KOD-RRMMDD-NN, np. WIL-261017-04 – punkt, data odbioru, kolejny numer w punkcie tego dnia
  number String            @unique @db.VarChar(20)
  status ReservationStatus @default(NEW)

  pickupType  PickupType
  location    Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationId  String?
  vanStop     BreadVanLocation? @relation(fields: [vanStopId], references: [id], onDelete: SetNull)
  vanStopId   String?
  // kopia adresu na wypadek zmian/usunięcia punktu
  pickupLabel String
  // data odbioru YYYY-MM-DD (czas polski) i godzina lub przedział, np. "08:00" / "14:00–17:00"
  pickupDate  String            @db.VarChar(10)
  pickupTime  String?           @db.VarChar(20)

  customerName  String  @db.VarChar(100)
  customerPhone String  @db.VarChar(20)
  customerEmail String  @db.VarChar(200)
  notes         String? @db.VarChar(500)

  total        Decimal           @db.Decimal(10, 2)
  cancelToken  String            @unique @db.VarChar(64)
  cancelledAt  DateTime?
  // dane klienta usunięte (po okresie przechowywania lub na żądanie) – zostają produkty, daty, punkt
  anonymizedAt DateTime?
  items        ReservationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pickupDate, status])
  @@index([customerPhone])
}

model ReservationItem {
  id            String      @id @default(uuid())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reservationId String
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId     String?
  // kopia nazwy i ceny z chwili rezerwacji
  productName   String
  unitPrice     Decimal     @db.Decimal(10, 2)
  quantity      Int
}

// Baner informacyjny pod nawigacją strony (np. zamknięty lokal, promocja, przerwa chlebowozu)
model Announcement {
  id        String    @id @default(uuid())
  message   String    @db.VarChar(160)
  // link: ścieżka na stronie (/aktualnosci/...) albo pełny adres https://...
  linkUrl   String?   @db.VarChar(500)
  linkLabel String?   @db.VarChar(40)
  isActive  Boolean   @default(true)
  // okres wyświetlania; puste = od razu / bezterminowo
  startsAt  DateTime?
  endsAt    DateTime?
  // kolejność przy kilku aktywnych komunikatach
  order     Int       @default(0)
  // komunikat stały ("promo"): pokazywany automatycznie, gdy trwa jakakolwiek promocja – bez usuwania
  system    String?   @unique @db.VarChar(20)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum NewsletterStatus {
  PENDING // zapis czeka na potwierdzenie linkiem z e-maila (double opt-in)
  CONFIRMED
  UNSUBSCRIBED
}

// Zapisy do newslettera (zgoda: art. 6 ust. 1 lit. a RODO); niepotwierdzone usuwane po 7 dniach
model NewsletterSubscriber {
  id             String           @id @default(uuid())
  email          String           @unique @db.VarChar(200)
  status         NewsletterStatus @default(PENDING)
  // jeden token do potwierdzenia i wypisania (losowy, w linkach z e-maili)
  token          String           @unique @db.VarChar(64)
  consentAt      DateTime
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

// STATYSTYKI – dzienne liczniki bez danych osobowych (odsłony stron, wczytania mapy, wysłane e-maile)
model DailyStat {
  id     Int    @id @default(autoincrement())
  // dzień w czasie polskim, YYYY-MM-DD
  date   String @db.Char(10)
  // view | map | mail | mail_failed
  metric String @db.VarChar(20)
  // np. ścieżka podstrony, miejsce mapy, rodzaj e-maila
  key    String @default("") @db.VarChar(100)
  count  Int    @default(0)

  @@unique([date, metric, key])
  @@index([metric, date])
}

// TREŚCI STRONY („domowy WordPress”) – teksty i zdjęcia sekcji edytowane w panelu.
// Klucz sekcji, np. "home.values"; data – pola sekcji (opis pól i wartości domyślne: modules/content/sections.ts).
// Brak wiersza = wartości domyślne (obecne teksty strony).
model SiteContent {
  key       String   @id @db.VarChar(60)
  data      Json
  updatedAt DateTime @updatedAt
}

// Rodzaj slajdu karuzeli: własny albo automatyczny (dane z panelu: trasa chlebowozu, liczba piekarni, produkty sezonowe)
enum HeroSlideKind {
  CUSTOM
  VAN
  BAKERIES
  SEASONAL
}

// Slajd karuzeli na górze strony głównej
model HeroSlide {
  id                  String        @id @default(uuid())
  kind                HeroSlideKind @default(CUSTOM)
  // krótka nazwa pod paskiem postępu karuzeli
  name                String        @db.VarChar(20)
  eyebrow             String        @db.VarChar(50)
  // tytuł w dwóch liniach (druga – złota); BAKERIES: {piekarnie} → „4 piekarnie”
  titleLine1          String        @db.VarChar(30)
  titleLine2          String        @default("") @db.VarChar(30)
  text                String        @db.VarChar(220)
  cta1Label           String?       @db.VarChar(30)
  cta1Href            String?       @db.VarChar(300)
  cta2Label           String?       @db.VarChar(30)
  cta2Href            String?       @db.VarChar(300)
  // zdjęcie na komputer (SEASONAL bez zdjęcia – zdjęcie produktu sezonowego) i opcjonalnie osobny kadr na telefon
  imageUrl            String?       @db.VarChar(500)
  imageAlt            String        @default("") @db.VarChar(160)
  // punkt kadrowania, np. "60% center"
  imagePosition       String        @default("center") @db.VarChar(30)
  mobileImageUrl      String?       @db.VarChar(500)
  mobileImagePosition String        @default("center") @db.VarChar(30)
  isActive            Boolean       @default(true)
  startsAt            DateTime?
  endsAt              DateTime?
  order               Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
