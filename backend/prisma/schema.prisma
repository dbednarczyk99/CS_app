// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


// USER & AUTH 
enum Role {
  ADMIN
  EDITOR
  BLOGGER
  VIEWER
}

model User {
  id          String  @id @default(uuid())
  role        Role
  login       String  @unique
  password    String
}


// PRODUCTS
model Category {
  id          String  @id @default(uuid())
  name        String
  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String   @db.Text
  price       Float
  isSeasonal  Boolean   @default(false)
  isActive    Boolean   @default(true)
  images      ProductImages[]
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductImages {
  id          String @id @default(uuid())
  imgUrl      String
  order       Int
  product     Product @relation(fields: [productId], references: [id])
  productId   String

  @@unique([productId, order])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


// CONTACT INFO

model Location {
  id              String    @id @default(uuid())
  name            String?
  address         String
  phone           String?
  googleMapsUrl   String
  openingHours    Json?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum ContactType {
  PHONE
  EMAIL
  OTHER
}

model ContactInfo {
  id          String @id @default(uuid())
  type        ContactType
  label       String?
  value       String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


// BREAD-VAN

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY 
  FRIDAY 
  SATURDAY 
  SUNDAY 
}

model BreadVanLocation {
  id              String @id @default(uuid())
  address         String
  googleMapsUrl   String
  dayOfTheWeek    Weekday @unique
  startTime       String
  endTime         String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BreadVanDescription {
  id               String @id @default("singleton")
  shortDescription String
  longDescription  String @db.VarChar(500)
  images           BreadVanImages[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BreadVanImages {
  id                        String @id @default(uuid())
  imgUrl                    String
  order                     Int
  breadVanDescription       BreadVanDescription @relation(fields: [descriptionId], references: [id] )
  descriptionId             String

  @@unique([descriptionId, order])
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}


// SOCIAL MEDIA

enum MediaName {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  LINKEDIN
  TWITTER
  PINTEREST
  YOUTUBE
}

model Media {
  id        String @id @default(uuid())
  url       String
  name      MediaName @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// BLOG

// BLOG

model ArticleImages {
  id          String @id @default(uuid())
  imgUrl      String
  order       Int
  article     Article @relation(fields: [articleId], references: [id])
  articleId   String

  @@unique([articleId, order])  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Article {
  id                String  @id @default(uuid())
  title             String
  shortDescription  String  @db.VarChar(500)
  content           String  @db.Text
  images            ArticleImages[]
  tags              TagOnArticle[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ArticleTag {
  id          String @id @default(uuid())
  name        String @unique
  articles    TagOnArticle[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TagOnArticle {
  article       Article @relation(fields: [articleId], references: [id])
  articleId     String

  tag           ArticleTag @relation(fields: [tagId], references: [id])
  tagId         String
  
  @@id([articleId, tagId])
}
